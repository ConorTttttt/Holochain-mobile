 use lair_keystore_api::types::SharedLockedArray;
 use std::sync::Mutex;
 
+/// Builds the conductor's network layer from its p2p config and keystore.
+///
+/// The default is [`holochain_p2p::spawn_holochain_p2p`]. Another factory lets
+/// an embedder supply a different [`holochain_p2p::actor::HcP2p`], such as one
+/// that reaches the network through a proxy instead of a local Kitsune2.
+pub type P2pFactory = Box<
+    dyn FnOnce(
+            holochain_p2p::HolochainP2pConfig,
+            MetaLairClient,
+        ) -> futures::future::BoxFuture<
+            'static,
+            holochain_p2p::HolochainP2pResult<holochain_p2p::actor::DynHcP2p>,
+        > + Send,
+>;
+
+async fn spawn_p2p(
+    factory: Option<P2pFactory>,
+    config: holochain_p2p::HolochainP2pConfig,
+    keystore: MetaLairClient,
+) -> holochain_p2p::HolochainP2pResult<holochain_p2p::actor::DynHcP2p> {
+    match factory {
+        Some(factory) => factory(config, keystore).await,
+        None => holochain_p2p::spawn_holochain_p2p(config, keystore).await,
+    }
+}
+
