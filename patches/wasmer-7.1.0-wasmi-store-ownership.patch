+/// A C API object created in a store, to be deleted with it.
+///
+/// Each one holds a reference to the underlying `wasmi` store, which is only
+/// freed, with its instances and linear memories, once every such object is
+/// deleted. Externs are only valid as long as their store, so they are
+/// deleted when the store is dropped.
+pub(crate) enum OwnedHandle {
+    Extern(*mut wasm_extern_t),
+    Func(*mut wasm_func_t),
+    Global(*mut wasm_global_t),
+    Memory(*mut wasm_memory_t),
+    Table(*mut wasm_table_t),
+}
+
